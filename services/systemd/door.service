# The door as a systemd service, beside ciel-hub on the same box.
#
#     sudo cp services/systemd/door.service /etc/systemd/system/
#     sudo systemctl daemon-reload && sudo systemctl enable --now door
#
# Config: ~/.door/config.toml (see door/config.py). Logs: journalctl -u door -f.
# It binds the tailnet address, so it waits for tailscaled like the hub does.
[Unit]
Description=The door (yunhan.me accounts, store, static sites)
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=ciel
WorkingDirectory=/home/ciel/yunhan.me/door
Environment=PYTHONUNBUFFERED=1
Environment=DOOR_CONFIG=/home/ciel/.door/config.toml
ExecStart=/home/ciel/yunhan.me/door/.venv/bin/door serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
